{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@botiverse/raft-ui": ["../../packages/ui/src/index.ts"],
      "@botiverse/raft-ui/cn": ["../../packages/ui/src/lib/cn.ts"],
      "@botiverse/raft-ui/fonts.css": ["../../packages/ui/src/fonts.css"],
      "@botiverse/raft-ui/styles.css": ["../../packages/ui/src/styles.css"],
      "@botiverse/raft-ui/wip": ["../../packages/ui/src/wip.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
