{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Cloudflare Worker this deploys to: "raft-design", which
  // serves raft-design.botiverse.build and is the Worker Workers Builds is
  // connected to (its check is "Workers Builds: raft-design"). The Worker was
  // renamed from "rui" on 2026-10-26; the old rui.botiverse.build domain is
  // gone. Wrangler refuses a deploy whose name differs from the connected Worker.
  // Workers Builds settings (Cloudflare dashboard, Worker raft-design → Settings
  // → Build): build command empty; deploy command `pnpm --filter doc run deploy`
  // (main); Preview command `pnpm --filter doc run preview:deploy` (PRs).
  // Wrangler requires an explicit `previews` block even when the Preview has no
  // separate bindings or variables. Both commands build raft-ui and the site first.
  "name": "raft-design",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "previews": {},
  "observability": {
    "enabled": true,
  },
}
