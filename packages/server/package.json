{
  "name": "@slock-ai/server",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:api": "node --import tsx --test 'src/**/*.api.test.ts'",
    "test:e2e:server": "tsx src/test/startPlaywrightServer.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "search:backfill": "tsx scripts/backfill-search.ts",
    "mentions:backfill": "tsx scripts/backfill-message-mentions.ts",
    "newsletter:backfill": "tsx scripts/backfill-newsletter-audience.ts",
    "translations:backfill": "tsx scripts/backfill-message-translations.ts",
    "risingwave:verify-inbox-parity": "tsx scripts/verify-risingwave-inbox-parity.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@electric-sql/pglite": "^0.4.4",
    "@slock-ai/shared": "workspace:*",
    "@smithy/node-http-handler": "^4.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jieba-wasm": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "resend": "^6.10.0",
    "scopedb": "0.0.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
