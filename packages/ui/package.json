{
  "name": "raft-ui",
  "version": "0.0.7",
  "description": "React UI components for Raft.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/rui.git",
    "directory": "packages/ui"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cn": {
      "types": "./dist/cn.d.mts",
      "default": "./dist/cn.mjs"
    },
    "./wip": {
      "types": "./dist/wip.d.mts",
      "default": "./dist/wip.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "cnfast": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260620.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
