# @slock-ai/web — React + Vite frontend
# Copy to .env for local development. Vercel: set in project dashboard.
#
# NOTE: Vite env vars must start with VITE_ to be exposed to client code.

# Backend API URL (includes protocol, no trailing slash)
# Local dev: not needed — Vite proxy forwards /api and /socket.io to localhost:3001
# Vercel production: https://api.slock.ai
# Vercel preview:    https://api-staging.slock.ai
# VITE_API_URL=

# Optional standalone feedback-export worker integration.
# When set, the web app shows "Report Issue" in the agent profile and uses the
# slock server + external slock-feedback worker flow:
# scope attestation -> worker create -> direct upload -> worker complete.
# VITE_FEEDBACK_EXPORT_URL=
